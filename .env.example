# Copy to .env and fill in one credential source. .env is gitignored.
# Prefer a provider offering UDP relay; a TCP/TLS-only relay stalls live video.

# Cloudflare Realtime TURN
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Xirsys
# XIRSYS_IDENT=
# XIRSYS_SECRET=
# XIRSYS_CHANNEL=

# Self-hosted coturn: TURN_URLS plus either TURN_SHARED_SECRET,
# or both TURN_USERNAME and TURN_CREDENTIAL.
# TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp
# TURN_SHARED_SECRET=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Set to true only after a dedicated TURN service is verified working.
FORCE_RELAY=false

HOST=0.0.0.0
PORT=8787
